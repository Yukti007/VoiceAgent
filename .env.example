# Copy this file to `.env` (same directory) and fill in real values.
# `.env` is gitignored -- never commit real credentials.
#
# This single file configures both the backend API (app/main.py) and the
# LiveKit Agents worker (app/agent/agent.py). The frontend has its own
# frontend/.env.local (see frontend/.env.local.example) since Next.js only
# reads env files from its own project directory.

# --- LiveKit -----------------------------------------------------------
# Create a free project at https://cloud.livekit.io to get these three values
# (Settings -> Keys). LIVEKIT_URL looks like wss://your-project.livekit.cloud
LIVEKIT_URL=wss://YOUR_LIVEKIT_URL
LIVEKIT_API_KEY=YOUR_LIVEKIT_API_KEY
LIVEKIT_API_SECRET=YOUR_LIVEKIT_API_SECRET

# --- Sarvam AI (Saaras realtime STT, Bulbul streaming TTS) --------------
# Get a key at https://dashboard.sarvam.ai
SARVAM_API_KEY=YOUR_SARVAM_API_KEY
# BCP-47 language code for STT (STT mode is set to "codemix" in code for
# natural Hindi/English code-switching regardless of this base language).
SARVAM_STT_LANGUAGE=hi-IN
# BCP-47 language code + speaker for Bulbul TTS. Bulbul speakers read
# code-mixed Hindi/English text naturally even in a single language setting.
SARVAM_TTS_LANGUAGE=hi-IN
SARVAM_TTS_SPEAKER=anushka

# --- LLM provider abstraction -------------------------------------------
# Only "openai" is implemented in V0. See app/llm/provider.py to add another.
LLM_PROVIDER=openai
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
# Fast + inexpensive model, good for realtime voice turn-taking.
OPENAI_MODEL=gpt-4o-mini
# Can be a different (e.g. cheaper) model since post-call extraction isn't realtime.
OPENAI_EXTRACTION_MODEL=gpt-4o-mini

# --- Storage -------------------------------------------------------------
DATABASE_URL=sqlite:///./data/voice_agent.db

# --- App -------------------------------------------------------------------
DEFAULT_BUSINESS_ID=sharma-dental
APP_ENV=development
LOG_LEVEL=INFO

# --- API server --------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:3000
