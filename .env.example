# Copy this file to `.env` (same directory) and fill in real values.
# `.env` is gitignored -- never commit real credentials.
#
# This single file configures both the backend API (app/main.py) and the
# LiveKit Agents worker (app/agent/agent.py). The frontend has its own
# frontend/.env.local (see frontend/.env.local.example) since Next.js only
# reads env files from its own project directory.

# --- LiveKit -----------------------------------------------------------
# Create a free project at https://cloud.livekit.io to get these three values
# (Settings -> Keys). LIVEKIT_URL looks like wss://your-project.livekit.cloud
LIVEKIT_URL=wss://YOUR_LIVEKIT_URL
LIVEKIT_API_KEY=YOUR_LIVEKIT_API_KEY
LIVEKIT_API_SECRET=YOUR_LIVEKIT_API_SECRET

# --- Sarvam AI (Saaras realtime STT, Bulbul streaming TTS) --------------
# Get a key at https://dashboard.sarvam.ai
SARVAM_API_KEY=YOUR_SARVAM_API_KEY
# BCP-47 language code for STT, or "auto" (recommended, and the default) to run
# Sarvam's own per-utterance language identification instead of forcing every
# utterance through one language's model -- pinning this caused English speech
# to be mis-transcribed/dropped and misreported as Hindi. STT mode is set to
# "transcribe" in code (standard transcription in the detected language).
SARVAM_STT_LANGUAGE=auto
# BCP-47 language code + speaker for Bulbul TTS. Bulbul speakers read
# code-mixed Hindi/English text naturally even in a single language setting.
SARVAM_TTS_LANGUAGE=hi-IN
SARVAM_TTS_SPEAKER=pooja
# Used only when LLM_PROVIDER=sarvam below.
SARVAM_LLM_MODEL=sarvam-105b

# --- LLM provider abstraction -------------------------------------------
# "openai" (needs OPENAI_API_KEY + active billing), "sarvam" (reuses
# SARVAM_API_KEY above -- no extra signup, but Sarvam's Chat Completions API
# is currently beta-gated per-account), or "groq" (free tier, no card --
# get a key at https://console.groq.com/keys). See app/llm/provider.py.
LLM_PROVIDER=openai
# Optional failover chain used mid-call if LLM_PROVIDER errors or is slow,
# e.g. "groq" or "groq,sarvam". Providers without credentials are skipped.
LLM_FALLBACK_PROVIDERS=
# Seconds to wait on one provider before trying the next.
LLM_ATTEMPT_TIMEOUT=4.0
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
# Fast + inexpensive model, good for realtime voice turn-taking.
OPENAI_MODEL=gpt-4o-mini
# Can be a different (e.g. cheaper) model since post-call extraction isn't realtime.
OPENAI_EXTRACTION_MODEL=gpt-4o-mini
# Used only when LLM_PROVIDER=groq. Groq's exact model lineup varies by
# account/region -- if this 404s, run `GET https://api.groq.com/openai/v1/models`
# with your key to see what's actually available on your account.
GROQ_API_KEY=YOUR_GROQ_API_KEY
GROQ_MODEL=openai/gpt-oss-20b

# --- Turn-taking ---------------------------------------------------------
# "model" = LiveKit audio end-of-turn model + VAD (recommended; handles
# mid-sentence pauses). "vad" = silence-only.
TURN_DETECTION=model
ENDPOINTING_MIN_DELAY=0.3
ENDPOINTING_MAX_DELAY=2.5
PREEMPTIVE_GENERATION=true

# --- Interruptions (barge-in) --------------------------------------------
# bvc | nc | off  (bvc/nc require LiveKit Cloud)
NOISE_CANCELLATION=bvc
# adaptive (ignores backchannels like "haan"/"hmm") | vad
INTERRUPTION_MODE=adaptive
INTERRUPTION_MIN_DURATION=0.5
# Leave empty for the mode's default (adaptive: 0, vad: 2)
INTERRUPTION_MIN_WORDS=
FALSE_INTERRUPTION_TIMEOUT=1.0

# --- Agent worker --------------------------------------------------------
# Prewarmed processes kept ready for incoming calls (removes cold-start
# delay before the agent joins). Each one uses a few hundred MB of RAM.
AGENT_IDLE_PROCESSES=1

# --- Storage -------------------------------------------------------------
DATABASE_URL=sqlite:///./data/voice_agent.db

# --- App -------------------------------------------------------------------
DEFAULT_BUSINESS_ID=sharma-dental
APP_ENV=development
LOG_LEVEL=INFO

# --- API server --------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:3000
